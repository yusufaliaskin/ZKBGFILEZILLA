# Environment Variables for ZK Remote Operations Center
# Copy this file to .env and fill in the values

# Django
SECRET_KEY=change-me-to-a-random-secret-key-in-production
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1

# Database (SQLite for development)
DATABASE_URL=sqlite:///db.sqlite3

# Redis (optional, for Celery/caching)
REDIS_URL=redis://localhost:6379/0

# SSH Configuration
SSH_KEY_PATH=/path/to/ssh/keys

# Credential Encryption
ENCRYPTION_KEY=generate-a-fernet-key-here

# File Upload
FILE_UPLOAD_MAX_SIZE=104857600

# Application
APP_NAME=ZK Remote Operations Center
APP_ENV=development
